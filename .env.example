# Etsy app credentials from https://www.etsy.com/developers/your-apps
ETSY_CLIENT_ID=your_keystring
ETSY_SHARED_SECRET=your_shared_secret

# Must exactly match the callback URI configured in the Etsy app.
# Production should use HTTPS.
ETSY_REDIRECT_URI=https://your-domain.example/auth/etsy/callback

# Minimal scopes for reading the shop/listings and writing listings later.
ETSY_SCOPES=shops_r listings_r listings_w

# Generate separate random secrets, e.g. `openssl rand -base64 48`.
OAUTH_SESSION_SECRET=replace_with_a_long_random_secret
TOKEN_ENCRYPTION_SECRET=replace_with_another_long_random_secret

# Protects status/API endpoints from public access. Required in production.
INTERNAL_API_KEY=replace_with_a_long_random_api_key

PORT=3000
TOKEN_STORE_PATH=.data/etsy-token.enc
NODE_ENV=development
